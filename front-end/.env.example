# Use 127.0.0.1 (not localhost) to avoid Windows IPv6 (::1) delay.
# In `npm run dev`, this URL is also the Vite proxy target (same-origin /api).
VITE_API_URL=http://127.0.0.1:3404
# Porta local alternativa (ex.: Docker no host):
# VITE_API_URL=http://127.0.0.1:5027
#
# Produção (Docker): o .env NÃO entra no build (.dockerignore).
# Passe a URL pública no compose / build-arg, ex.:
#   VITE_API_URL=http://10.20.2.77:3404 docker compose up -d --build
# Ou defina VITE_API_URL no ambiente / arquivo .env ao lado do docker-compose
# (o compose lê ${VITE_API_URL} só para o build-arg).

