NODE_ENV=development
HOST=0.0.0.0
PORT=3404
# Dev local (Postgres publicado em 3406). No Docker use o host do serviço:
# DATABASE_URL=postgresql://docker:docker@solicitacao-marmita-database:5432/marmita_dev
DATABASE_URL=postgresql://docker:docker@localhost:3406/marmita_dev
# Mínimo de 32 caracteres. Gere um valor aleatório em produção.
JWT_SECRET=change-me-marmita-secret-min-32-chars
JWT_EXPIRES_IN=12h
# Origens extras do front, separadas por vírgula. FRONT_END_URL já é permitida.
# CORS_ORIGINS=http://127.0.0.1:5173
APPNAME=
APPKEY=
API_PEDERTRACTOR_URL=

# SMTP (mesmo correio interno do TractorCron)
CORREIO=
PORT_CORREIO=587
EMAIL_AUTOMACAO=
PASSWORD_AUTOMACAO=
FRONT_END_URL=http://localhost:5173
# Pasta local para avatares (servidos em /uploads)
UPLOADS_DIR=./uploads
