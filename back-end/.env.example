NODE_ENV=development
HOST=0.0.0.0
PORT=5027
DATABASE_URL=postgresql://docker:docker@localhost:5437/marmita_dev
# Mínimo de 32 caracteres. Gere um valor aleatório em produção.
JWT_SECRET=change-me-marmita-secret-min-32-chars
JWT_EXPIRES_IN=12h
# Origens extras do front, separadas por vírgula. FRONT_END_URL já é permitida.
# CORS_ORIGINS=http://127.0.0.1:5173
APPNAME=
APPKEY=
API_PEDERTRACTOR_URL=

# SMTP (mesmo correio interno do TractorCron)
CORREIO=
PORT_CORREIO=587
EMAIL_AUTOMACAO=
PASSWORD_AUTOMACAO=
FRONT_END_URL=http://localhost:5173
# Pasta local para avatares (servidos em /uploads)
UPLOADS_DIR=./uploads
